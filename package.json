{
  "name": "pre-dispute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent that prevents PayPal disputes before they happen, with outcome-based billing",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx --env-file=.env src/server.ts",
    "seed": "tsx --env-file=.env src/seed.ts",
    "seed:reset": "tsx --env-file=.env src/seed.ts reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4"
  },
  "engines": {
    "node": ">=24"
  }
}
